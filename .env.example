# OpenRouter Configuration (compatível com API OpenAI)
# Obtenha uma chave em: https://openrouter.ai
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo padrão (suportados pelo OpenRouter: google/gemini-*, openai/gpt-*, etc)
# Alguns modelos populares:
#   google/gemini-3.6-flash (rápido, barato)
#   openai/gpt-4-turbo (mais poderoso)
#   anthropic/claude-3-5-sonnet (Claude via OpenRouter)
LLM_MODEL=google/gemini-3.6-flash

# URL da API OpenRouter (não mudar)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: Debug mode
# DEBUG=False
