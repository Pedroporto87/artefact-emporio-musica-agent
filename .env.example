# LLM via OpenRouter (API compatível com OpenAI). Chave em https://openrouter.ai
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo validado no projeto. Outros modelos do OpenRouter funcionam, mas não foram reavaliados.
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# Opcional: cotação de frete para fora de Campo Grande (Melhor Envio).
# Sem o token, a Marina informa só as modalidades e os prazos do manual.
# Token gratuito no sandbox: https://sandbox.melhorenvio.com.br -> Integrações -> Permissões de acesso
# (permissão shipping-calculate).
MELHOR_ENVIO_TOKEN=
# MELHOR_ENVIO_URL=https://sandbox.melhorenvio.com.br
# MELHOR_ENVIO_USER_AGENT=Emporio da Musica (seu-email@exemplo.com)
